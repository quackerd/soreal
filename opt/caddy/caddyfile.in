{
    admin off

    persist_config off

    cert_issuer acme {
        disable_tlsalpn_challenge
    }

    auto_https disable_redirects

    storage file_system /opt/soreal/data/caddy

    skip_install_trust

    http_port 80

    servers 127.0.0.1:12345 {
        protocols h1 h2c
    }

    servers :80 {
        protocols h1
    }

    log {
        output stdout
        format console
        level info
    }
}

http://{{ HOST }}:80 {
    log {
        output file /opt/soreal/data/caddy/access.log {
            roll_disabled
        }
        format console
        level {{ CADDY_LOG_LEVEL }}
    }

    redir https://{{ HOST }}:{{ PORT }}{uri} 308
}

# Internal fallback site (not exposed, plain HTTP): Xray terminates TLS on 443
# and forwards non-VLESS traffic here. The address is host-less on purpose:
# fallback keeps the client's original Host header, so matching a host (e.g.
# 127.0.0.1) would never route. `bind` keeps the listener on loopback and makes
# it match the `servers 127.0.0.1:12345` protocols above.
http://:12345 {
    bind 127.0.0.1
    encode

    log {
        output file /opt/soreal/data/caddy/access.log {
            roll_disabled
        }
        format console
        level {{ CADDY_LOG_LEVEL }}
    }

    handle {
        {% if SITE_URL %}
        reverse_proxy {{ SITE_URL }}
        {% else %}
        respond 404
        {% endif %}
    }
}

https://{{ HOST }}:12346 {
    bind 127.0.0.1
{% if SELF_SIGN %}
    tls internal
{% endif %}
}
