# Global Options Block
{
    admin off

    persist_config off

    cert_issuer acme

    storage file_system /opt/soreal/data/caddy/data

    skip_install_trust

    http_port 80

    servers :12345 {
        protocols h1 h2c
    }

    log {
        output stdout
        format console
        level info
    }
}

http://{{ HOST }}:80 {
    redir https://{{ HOST }}:{{ PORT }}{uri} 308
}

# Internal fallback site (not exposed, plain HTTP): Xray terminates TLS on 443
# and forwards non-VLESS traffic here.
http://:12345 {
    bind 127.0.0.1

    encode

    handle {
        {% if SITE_URL %}
        reverse_proxy {{ SITE_URL }}
        {% else %}
        respond 404
        {% endif %}
    }
}

{% if SELF_SIGN %}
https://{{ HOST }}:12346 {
    tls internal
    bind 127.0.0.1
}
{% endif %}
